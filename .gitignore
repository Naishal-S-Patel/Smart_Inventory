# ============================================================
# Smart Inventory — Root .gitignore
# Covers: Spring Boot (Backend), React/Vite (Frontend), FastAPI/ML (ML)
# ============================================================

# ─────────────────────────────────────────────────────────────
# SENSITIVE / SECRETS — NEVER COMMIT
# ─────────────────────────────────────────────────────────────
*.env
.env
.env.*
!.env.example          # allow example template files

# Backend — real application properties (use application.yml.example)
Backend/src/main/resources/application.yml
Backend/src/main/resources/application-*.yml
!Backend/src/main/resources/application.yml.example

# ─────────────────────────────────────────────────────────────
# ML — Large data files, trained models, graphs & databases
# ─────────────────────────────────────────────────────────────
ML/ml_service/models/
ML/ml_service/mlruns/
ML/ml_service/mlruns.db
ML/ml_service/mlflow.db
ML/ml_service/reports/
ML/ml_service/daily_sales_dataset.csv
ML/ml_service/features_dataset.csv

# Any pickle / joblib / HDF5 / ONNX model files anywhere
**/*.pkl
**/*.pickle
**/*.joblib
**/*.h5
**/*.hdf5
**/*.onnx
**/*.pt
**/*.pth
**/*.bin

# PNG/SVG/HTML charts generated by matplotlib / plotly
**/charts/*.png
**/charts/*.svg
**/charts/*.html
**/forecasts/*.png
**/forecasts/*.json
**/analytics/*.png
**/analytics/*.json

# ─────────────────────────────────────────────────────────────
# PYTHON
# ─────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
*.egg
.eggs/
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.coverage
.coverage
htmlcov/
.tox/
.nox/
*.log

# ─────────────────────────────────────────────────────────────
# NODE / FRONTEND
# ─────────────────────────────────────────────────────────────
node_modules/
Frontend/dist/
Frontend/.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.local

# ─────────────────────────────────────────────────────────────
# JAVA / MAVEN (Backend)
# ─────────────────────────────────────────────────────────────
Backend/target/
*.class
*.jar
*.war
*.ear
*.nar
hs_err_pid*
replay_pid*
effective-pom

# ─────────────────────────────────────────────────────────────
# IDE / EDITOR
# ─────────────────────────────────────────────────────────────
.idea/
.vscode/
*.iml
*.iws
*.ipr
.project
.classpath
.settings/
*.suo
*.user
*.userosscache
*.sln.docstates
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ─────────────────────────────────────────────────────────────
# MISC
# ─────────────────────────────────────────────────────────────
*.tmp
*.bak
*.orig
